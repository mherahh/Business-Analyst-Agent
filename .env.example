# =====================================================================
# Business Analyst Agent - Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# LLM Provider Configuration
# Supported options: "gemini" or "openrouter"
# ---------------------------------------------------------------------
LLM_PROVIDER=openrouter

# OpenRouter Settings (Used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini Settings (Used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# Vector Store & Embedding Configuration (RAG)
# Supported EMBEDDING_PROVIDER options:
#   - "local"  : Uses sentence-transformers/all-MiniLM-L6-v2 (offline/cached, no key required)
#   - "gemini" : Uses Google Gemini text-embedding-004 (requires GEMINI_API_KEY)
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ---------------------------------------------------------------------
# Retrieval-Augmented Generation (RAG) Hyperparameters
# ---------------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.15
